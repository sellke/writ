#!/usr/bin/env python3
"""Stub `go` for the review-override evidence tests. It prints the
go output for STUB_MODE and exits with go's code. See _stub.py."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _stub import run  # noqa: E402

MODES = {
    "fail": (1, "--- FAIL: TestNegativeLimit (0.00s)\n"
                "    limits_test.go:9: parseLimit(-1) = -1, want an error\n"
                "FAIL\nFAIL\texample.com/limits/pkg\t0.002s\nFAIL\n"),
    "pass": (0, "ok  \texample.com/limits/pkg\t0.002s\n"),
    "build": (1, "# example.com/limits/pkg [example.com/limits/pkg.test]\n"
                 "pkg/limits_test.go:4:2: undefined: parseLimit\n"
                 "FAIL\texample.com/limits/pkg [build failed]\nFAIL\n"),
    "setup": (1, "FAIL\texample.com/limits/pkg [setup failed]\nFAIL\n"),
    # A `--- FAIL:` line from one package beside a build failure in another.
    "mixed": (1, "--- FAIL: TestNegativeLimit (0.00s)\n"
                 "FAIL\texample.com/limits/pkg\t0.002s\n"
                 "FAIL\texample.com/limits/other [build failed]\nFAIL\n"),
}

if __name__ == "__main__":
    sys.exit(run(MODES))
