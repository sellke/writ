    "outside_fail": (1, "F\n\nAn error occurred in a `before(:suite)` hook.\n\n"
                        "1 example, 1 failure, 1 error occurred outside of examples\n"),
}

if __name__ == "__main__":
    sys.exit(run(MODES))
