"""Stub `lint` for the review-override evidence tests. It prints the
lint output for STUB_MODE and exits with lint's code. See _stub.py."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _stub import run  # noqa: E402

# A static check Gate 2 recorded. `absolute` prints the path the way
# eslint's default formatter does: absolute, on a line of its own.
MODES = {
    "names": (1, "src/limits.py:3:5: E100 negative limit is not rejected\nFound 1 error.\n"),
    "absolute": (1, "{cwd}/src/limits.py\n  3:5  error  negative limit is not rejected\n"),
    "other": (1, "src/routes.py:5:5: E100 limit is not range-checked\nFound 1 error.\n"),
    "clean": (0, "All checks passed!\n"),
}

if __name__ == "__main__":
    sys.exit(run(MODES))
