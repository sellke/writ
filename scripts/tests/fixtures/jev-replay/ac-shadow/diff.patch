diff --git a/src/greet.py b/src/greet.py
new file mode 100644
--- /dev/null
+++ b/src/greet.py
@@ -0,0 +1,4 @@
+def greet(name: str) -> str:
+    if not name:
+        return "Hello, stranger!"
+    return "Hello, %s!" % name
